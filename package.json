{
  "name": "dsh-gui-guard",
  "version": "0.1.1",
  "description": "先确认这个窗口现在能不能安全操作，再动手点击或输入——最小化、不在前台、DPI 缩放都替你处理掉。 Windows window-operation reliability layer: probe whether a window is minimized, in the foreground or DPI-scaled, then click and type with the coordinate space handled.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./win32": "./lib/win32.ps1",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "windows",
    "gui-automation",
    "computer-use",
    "dpi-scaling",
    "coordinates",
    "click",
    "sendkeys",
    "reliability",
    "窗口",
    "自动化",
    "坐标"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7gzgn/dsh-gui-guard.git"
  },
  "homepage": "https://github.com/7gzgn/dsh-gui-guard#readme",
  "bugs": {
    "url": "https://github.com/7gzgn/dsh-gui-guard/issues"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
